# ---- Public site (Phase 1) ----
# Canonical URL used for metadata, sitemap and JSON-LD. Vercel: set per environment.
NEXT_PUBLIC_SITE_URL=https://greendale-school.vercel.app

# Contact form (Nodemailer over SMTP). Without these the form politely asks visitors to call.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Greendale Website <no-reply@your-school-domain>"
CONTACT_TO=office@your-school-domain

# true when Cloudflare sits in front (changes which header holds the real client IP)
BEHIND_CLOUDFLARE=false

# ---- Data mode ----
# demo (default, Vercel sales demo): sample data, no backend needed.
# live (local dev + VPS): everything comes from the Express API. Set BEFORE `next build` and `next start`.
DATA_MODE=demo
# Required when DATA_MODE=live (no /api, no trailing slash)
API_INTERNAL_URL=http://127.0.0.1:4000
# Shared with greendale-back REVALIDATE_SECRET (Step 2 CMS)
REVALIDATE_SECRET=

# Demo mode only: signs the demo session cookie (32+ chars)
SESSION_SECRET=
